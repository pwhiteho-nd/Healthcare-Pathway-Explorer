modules = ["nodejs-24"]

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/healthcare-pathway-explorer run build"]
publicDir = "artifacts/healthcare-pathway-explorer/dist/public"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
